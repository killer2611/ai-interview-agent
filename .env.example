# --- LLM Configuration ---
# Your API key (OpenAI, Groq, or compatible provider)
OPENAI_API_KEY=your-api-key-here

# Base URL for the LLM provider (change for Groq, Ollama, etc.)
# OpenAI: https://api.openai.com/v1
# Groq:   https://api.groq.com/openai/v1
# Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Model name
LLM_MODEL=gpt-4o-mini

# Temperature settings for different call sites
LLM_TEMPERATURE_QUESTION=0.7
LLM_TEMPERATURE_EVALUATION=0.2
LLM_TEMPERATURE_FEEDBACK=0.3

# Retry and timeout
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30

# --- Interview Constraints ---
MIN_QUESTIONS=8
MAX_QUESTIONS=15
MIN_COVERED_DAYS=4
MIN_COVERED_MODULES=2
TARGET_QUESTIONS=10
MAX_FOLLOWUPS_PER_TOPIC=2

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --- Paths ---
CURRICULUM_PATH=curriculum.json
